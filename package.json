{
  "name": "kingdoms-call",
  "private": true,
  "description": "Kingdoms Call: the site (src/, built into site/) and its tests (tests/)",
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/dev.ts",
    "test": "vitest run",
    "test:full": "KC_FULL=1 vitest run",
    "test:quarantine": "KC_QUARANTINE=1 vitest run --project quarantine",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx tools/check.ts",
    "ratchet": "tsx tools/ratchet.ts",
    "balance": "tsx tools/balance/run.ts",
    "balance:update": "tsx tools/balance/run.ts --update",
    "balance:report": "tsx tools/balance/report-run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "acorn": "8.19.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
