{
  "name": "kingdoms-call",
  "private": true,
  "description": "Kingdoms Call: the site (src/, built into site/) and its tests (tests/)",
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/dev.ts",
    "test": "vitest run",
    "test:full": "KC_FULL=1 vitest run",
    "test:quarantine": "KC_QUARANTINE=1 vitest run --project quarantine",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:arch": "depcruise src --ignore-known --output-type err",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx tools/check.ts",
    "ratchet": "tsx tools/ratchet.ts",
    "balance": "tsx tools/balance/run.ts",
    "balance:update": "tsx tools/balance/run.ts --update",
    "balance:report": "tsx tools/balance/report-run.ts",
    "mutants": "tsx tools/mutants/run.ts",
    "proof:coverage": "tsx tools/proof/the-matrixs-coverage.ts",
    "proof:unreached": "tsx tools/proof/the-changed-lines-no-game-reaches.ts",
    "proof:plant": "tsx tools/proof/a-planted-fault.ts",
    "proof:gm-logs": "tsx tools/proof/the-gm-logs-compared.ts",
    "proof:two-engines": "tsx tools/proof/the-two-engines-compared.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "acorn": "8.19.0",
    "c8": "12.0.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
