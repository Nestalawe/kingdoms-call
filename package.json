{
  "name": "kingdoms-call",
  "private": true,
  "description": "Kingdoms Call: the site (src/, built into site/) and its tests (tests/)",
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/dev.ts",
    "test": "vitest run",
    "test:full": "KC_FULL=1 vitest run",
    "test:quarantine": "KC_QUARANTINE=1 vitest run --project quarantine --passWithNoTests",
    "test:db": "KC_DB=1 vitest run --project db",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:arch": "depcruise src --ignore-known --output-type err",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx tools/check.ts",
    "ratchet": "tsx tools/ratchet.ts",
    "balance": "tsx tools/balance/run.ts",
    "balance:update": "tsx tools/balance/run.ts --update",
    "balance:report": "tsx tools/balance/report-run.ts",
    "mutants": "tsx tools/mutants/run.ts",
    "proof:coverage": "tsx tools/proof/the-matrixs-coverage.ts",
    "proof:unreached": "tsx tools/proof/the-changed-lines-no-game-reaches.ts",
    "proof:plant": "tsx tools/proof/a-planted-fault.ts",
    "proof:plants": "tsx tools/proof/many-planted-faults-on-their-tests.ts",
    "proof:gm-logs": "tsx tools/proof/the-gm-logs-compared.ts",
    "proof:two-engines": "tsx tools/proof/the-two-engines-compared.ts",
    "proof:worlds": "tsx tools/proof/the-worlds-making-compared.ts",
    "proof:tours": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/proof/the-changed-lines-no-tour-reaches.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "acorn": "8.19.0",
    "c8": "12.0.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "overrides": {
    "minimatch": "11.0.7"
  }
}
