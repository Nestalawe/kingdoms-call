-- The shared test world for the access-rule tests. Included by every file in tests/database/ with
--   \ir ../lib/world.psql
-- inside that file's transaction, so it's rolled back with the file. Made-up names and ids only.
--
-- The points of view (pg_temp.kc_as(who)):
--   gm        the Game Master of Marchwood, Open Vale, Hidden Glen and Ashen Reach
--   gm2       another Game Master (of Fenmoor only)
--   p1        a player in Marchwood (realm 0); also played Ashen Reach
--   p2        a rival player in Marchwood (realm 1)
--   p4        a third player in Marchwood (realm 3), addressed by nobody's private dispatch
--   p3        a player in another game (Fenmoor, realm 0)
--   invitee   invited to Hidden Glen; in no game yet
--   stranger  signed in, in no game
--   anon      signed out
--   postgres  the test runner itself (bypasses the rules; used to stage and check data)
--
-- The games (pg_temp.kc_game(key)):
--   A  Marchwood    active, turn 3, GM gm: realms p1 (0), p2 (1), a bot (2), p4 (3)
--   B  Fenmoor      active, turn 2, GM gm2: realm p3 (0)
--   S  Open Vale    setup, public, GM gm
--   P  Hidden Glen  setup, private, GM gm, invites invitee
--   C  Ashen Reach  complete, GM gm: realm p1 (0); has a Hall of Fame record

set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create function pg_temp.kc_uid(who text) returns uuid language sql immutable as $$
  select (case who
    when 'gm'       then '00000000-0000-4000-a000-000000000001'
    when 'gm2'      then '00000000-0000-4000-a000-000000000002'
    when 'p1'       then '00000000-0000-4000-a000-000000000011'
    when 'p2'       then '00000000-0000-4000-a000-000000000012'
    when 'p3'       then '00000000-0000-4000-a000-000000000013'
    when 'p4'       then '00000000-0000-4000-a000-000000000014'
    when 'invitee'  then '00000000-0000-4000-a000-000000000021'
    when 'stranger' then '00000000-0000-4000-a000-000000000022'
  end)::uuid
$$;

create function pg_temp.kc_game(k text) returns uuid language sql immutable as $$
  select (case k
    when 'A' then '00000000-0000-4000-b000-00000000000a'
    when 'B' then '00000000-0000-4000-b000-00000000000b'
    when 'S' then '00000000-0000-4000-b000-000000000005'
    when 'P' then '00000000-0000-4000-b000-000000000006'
    when 'C' then '00000000-0000-4000-b000-00000000000c'
  end)::uuid
$$;

-- Act as one point of view, the way PostgREST does: a database role plus the request's JWT claims,
-- which auth.uid() reads.
create function pg_temp.kc_as(who text) returns void language plpgsql as $$
begin
  if who = 'postgres' then
    perform set_config('request.jwt.claims', '', true);
    perform set_config('role', 'none', true);
  elsif who = 'anon' then
    perform set_config('request.jwt.claims', '{"role":"anon"}', true);
    perform set_config('role', 'anon', true);
  else
    if pg_temp.kc_uid(who) is null then raise exception 'kc_as: unknown point of view %', who; end if;
    perform set_config('request.jwt.claims',
      json_build_object('sub', pg_temp.kc_uid(who), 'role', 'authenticated')::text, true);
    perform set_config('role', 'authenticated', true);
  end if;
end $$;

-- How many rows a write would change, as the current point of view. The write is always undone, so
-- probes never disturb the world for the tests after them. A refusal (a rule or a missing privilege,
-- SQLSTATE 42501) counts as 0 rows. Any other error is a real failure and propagates.
create function pg_temp.kc_writes(q text) returns int language plpgsql as $$
declare n int;
begin
  begin
    execute q;
    get diagnostics n = row_count;
    raise exception using errcode = 'KCUND', message = n::text;
  exception
    when insufficient_privilege then return 0;
    when sqlstate 'KCUND' then return sqlerrm::int;
  end;
end $$;

-- How many rows a query returns, as the current point of view. A refusal (SQLSTATE 42501, e.g. a
-- column the reader may not select) counts as 0 rows.
create function pg_temp.kc_count(q text) returns int language plpgsql as $$
declare n int;
begin
  execute 'select count(*) from (' || q || ') kc_q' into n;
  return n;
exception when insufficient_privilege then return 0;
end $$;

-- What a call does, reduced to "ok:<result>" or "error:<SQLSTATE>", so two calls can be compared.
create function pg_temp.kc_outcome(q text) returns text language plpgsql as $$
declare r text;
begin
  execute q into r;
  return 'ok:' || coalesce(r, 'null');
exception when others then return 'error:' || sqlstate;
end $$;

-- ── the world (staged as postgres, which owns the tables and so isn't held by their rules) ───────

