insert into public.games (id, name, gm_user_id, status, turn, max_players, game_state, meta) values
  (pg_temp.kc_game('A'), 'Marchwood',   pg_temp.kc_uid('gm'),  'active',   3, 4,
     '{"world":"Marchwood hidden world"}', '{"turnMode":{"mode":"manual"}}'),
  (pg_temp.kc_game('B'), 'Fenmoor',     pg_temp.kc_uid('gm2'), 'active',   2, 4,
     '{"world":"Fenmoor hidden world"}', '{"turnMode":{"mode":"manual"}}'),
  (pg_temp.kc_game('S'), 'Open Vale',   pg_temp.kc_uid('gm'),  'setup',    0, 4,
     '{"mapSize":"p4","seaPct":35}', null),
  (pg_temp.kc_game('P'), 'Hidden Glen', pg_temp.kc_uid('gm'),  'setup',    0, 4,
     jsonb_build_object('mapSize', 'p4', 'visibility', 'private',
                        'invited', jsonb_build_array(pg_temp.kc_uid('invitee'))), null),
  (pg_temp.kc_game('C'), 'Ashen Reach', pg_temp.kc_uid('gm'),  'complete', 9, 4,
     '{"world":"Ashen Reach final world"}', null);

